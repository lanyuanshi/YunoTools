<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7EEF4">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.28"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_sakura" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#72FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 个人资料页里的我的页面入口：点击进入独立我的页面 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatarHeader"
                android:layout_width="match_parent"
                android:layout_height="126dp"
                android:layout_marginTop="0dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#EFFFFFFF"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeColor="#77FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="18dp">

                    <FrameLayout
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:background="@drawable/bg_circle_blue">

                        <ImageView
                            android:id="@+id/ivProfileEntryAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="18dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile" />

                        <androidx.media3.ui.PlayerView
                            android:id="@+id/pvProfileEntryAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            app:resize_mode="zoom"
                            app:use_controller="false" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProfileEntryTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="进入我的页面"
                            android:textColor="#1F1722"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileEntryHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="点这里进入：头像 / 登录 / 会员 / 签到"
                            android:textColor="#7A6674"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_circle_blue_light"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#5B6EE1"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="12dp"
                android:text="个人资料功能"
                android:textColor="#3D2B36"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardParseHistory"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#EFFFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="24dp" android:text="解析历史" android:textColor="#2C2430" android:textSize="17sp" android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMusicDownloads"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#EFFFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="24dp" android:text="下载内容" android:textColor="#2C2430" android:textSize="17sp" android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#EFFFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="24dp" android:text="设置" android:textColor="#2C2430" android:textSize="17sp" android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
