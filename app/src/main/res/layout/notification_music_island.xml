<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMusicIsland"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav_floating_indicator"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingTop="10dp"
    android:paddingRight="14dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/ivMusicIslandIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_nav_music_disc"
        android:tint="#007AFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMusicIslandTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#111827"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMusicIslandSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#4B5563"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMusicIslandStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@android:color/transparent"
        android:textColor="#007AFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnMusicIslandPrevious"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="‹‹"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnMusicIslandToggle"
        android:layout_width="38dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="Ⅱ"
        android:textColor="#007AFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnMusicIslandNext"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="››"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
